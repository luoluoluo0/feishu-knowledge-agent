# ===== 生成模型（DeepSeek）=====
DEEPSEEK_API_KEY=your_deepseek_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== 向量与重排（硅基流动）=====
SILICON_API_KEY=your_siliconflow_key
EMBEDDINGS_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDINGS_MODEL=BAAI/bge-large-zh-v1.5
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_MIN_SCORE=0.8

# ===== Milvus（飞书 Docx/PDF 正文检索）=====
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=feishu_paper_child_bm25
RETRIEVAL_TOP_K=5

# ===== Qdrant（可选：PPT/文献卡片旧语料兼容链路）=====
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=feishu_paper_share

# ===== 检索策略 =====
# rerank 门槛按意图分档：事实类用 RERANK_MIN_SCORE，总结类用 RERANK_MIN_SCORE_SUMMARY
RERANK_THRESHOLD_BY_INTENT=true
RERANK_MIN_SCORE_SUMMARY=0.35
PARENT_EXPAND_ENABLED=true
PARENT_EXPAND_MAX_CHARS=1600
QUERY_CACHE_ENABLED=true
QUERY_CACHE_TTL_SECONDS=3600
QUERY_CACHE_MAX_ENTRIES=256
# 翻译缓存：确定性调用（temperature=0），TTL 可比查询缓存长
TRANSLATION_CACHE_ENABLED=true
TRANSLATION_CACHE_TTL_SECONDS=86400
TRANSLATION_CACHE_MAX_ENTRIES=512

# ===== 会话与运行时 =====
CONTEXT_WINDOW_ENABLED=true
CONTEXT_WINDOW_MAX_TOKENS=24000
DATA_RETENTION_DAYS=90
APP_THREADPOOL_TOKENS=120
# 单次请求 token 告警阈值（超过打 WARNING 并在前端标红）
TOKEN_ALERT_THRESHOLD=50000
FEISHU_LLM_TIMEOUT_SECONDS=60

# ===== 接口保护 =====
# 新变量优先；FEISHU_SERVICE_API_KEY 仅为旧部署兼容，后续会移除。
SERVICE_API_KEY=replace-with-a-random-service-key
# FEISHU_SERVICE_API_KEY=
FEISHU_RATE_LIMIT_PER_MINUTE=3
# 会话改写历史库；留空使用默认路径 data/runtime/conversation_history.db
FEISHU_CONVERSATION_DB_PATH=

# ===== Langfuse 全链路追踪 =====
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development

# ===== 图表专家（自部署微调模型，Agent 第 11 个工具）=====
# 总闸默认关闭；开启前先确认微调模型服务可达（本地隧道或同机）
# CHART_EXPERT_ENABLED=true
# CHART_EXPERT_BASE_URL=http://127.0.0.1:18000/v1
# CHART_EXPERT_MODEL=qwen2.5-7b-lora-v2
# CHART_EXPERT_TIMEOUT=60

# ===== 飞书共享文件夹自动同步 =====
# 应用凭证只放 .env，禁止提交；文件夹 token 可用逗号分隔多个。
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=replace-with-feishu-app-secret
FEISHU_FOLDER_TOKENS=fldcnxxxxxxxxxxxxxxxx
FEISHU_SYNC_ENABLED=true
FEISHU_EVENT_MODE=websocket
FEISHU_RECONCILE_INTERVAL_SECONDS=3600
FEISHU_SYNC_DB_PATH=data/runtime/feishu_sync.db
FEISHU_SYNC_DOWNLOAD_DIR=data/runtime/feishu_sync/files
FEISHU_ALLOWED_TYPES=docx,pdf
FEISHU_DELETE_GRACE_DAYS=7
FEISHU_WORKER_MAX_ATTEMPTS=5
FEISHU_PDF_PARSER=auto
