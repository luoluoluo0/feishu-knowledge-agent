.tmp_pip/
*.log
*.sqlite3-journal
*.db-shm
*.db-wal

# ===== 编辑器 / 系统 =====
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ===== ZCode 本地工作目录 =====
.zcode/
.zcodeignore
langfuse-credentials.txt

# LLM 评判的逐条结果（同 result_*，跑完的产物不入库）
data/eval/judged_*.jsonl

# ===== 模型权重不入库 =====
finetune/**/models/
*.safetensors
*.gguf

